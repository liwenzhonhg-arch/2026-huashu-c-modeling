      "objective": "\\min_{\\beta_{0,rk},\\boldsymbol\\beta_{rk}}\\sum_{t\\in\\mathcal T_{train}^{*}}\\rho_{\\delta_H}(D_{rkt}-\\beta_{0,rk}-\\boldsymbol\\beta_{rk}^{\\top}\\boldsymbol\\phi_{rkt})+\\lambda\\|\\boldsymbol\\beta_{rk}\\|_2^2;\\quad \\widehat D_{rkt}=\\max\\{0,\\beta_{0,rk}+\\boldsymbol\\beta_{rk}^{\\top}\\boldsymbol\\phi_{rkt}\\};\\quad \\min_x\\sum_{i,r,s}x_{irs}[\\alpha_{k_i}(s-a_i)+\\beta_{k_i}\\ell_{o_i r}]",
      "constraints": [
