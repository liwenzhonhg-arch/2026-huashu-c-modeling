  "formulation": {
    "model_family": "现役候选q1_enhanced：滞后与日周周期特征正则化回归，加最后24小时MILP；q1_baseline作为预测和调度基准及MILP热启动；现役候选q2_enhanced：滚动时域ε-约束多目标MILP；q2_baseline用于取得成本参照解和可行热启动；现役候选q3_enhanced：含充放电互斥、峰值和绝对爬坡线性化的储能MILP；仅当q3_baseline试算自然消除无效循环时才可退化为LP；现役候选q4_enhanced：ε-约束Pareto联合优化和情景分析，以q4_baseline分层滚动联合MILP作为求解骨架与基准",
    "objectives": [
      {
        "id": "OBJ-Q1",
        "meaning": "\\min \\left(\\mathrm{WAPE}_{val},\\ \\mathrm{MAE}_{val}\\right);\\qquad \\min \\sum_i\\sum_{r,s}x_{irs}\\left[\\alpha(s-a_i)+\\beta\\ell_{o_i r}\\right]",
        "unit": ""
      },
      {
        "id": "OBJ-Q2",
        "meaning": "\\min C_{op}=\\sum_{r,t}(\\pi_{rt}^{buy}B_{rt}-\\pi_{rt}^{sell}S_{rt})\\Delta t",
        "unit": ""
      },
      {
        "id": "OBJ-Q3",
        "meaning": "\\min \\left\\{C_{op},E_{CO2},\\sum_rP_r^{peak},\\sum_{r,t\\ge1}z_{rt}\\right\\}\\text{，通过ε约束逐次求解}",
        "unit": ""
      },
      {
        "id": "OBJ-Q4",
        "meaning": "\\min C_{op}\\ \\text{s.t.}\\ E_{CO2}\\le\\varepsilon_C,\\ L_{net}\\le\\varepsilon_L,\\ U_{RE}\\ge\\varepsilon_U,\\ Q_{service}\\ge\\varepsilon_Q,\\ P_r^{peak}\\le\\varepsilon_{P,r}",
        "unit": ""
      }
    ],
    "constraints": [
