      {
        "id": "CON-Q1-15",
        "meaning": "S_k=median_i max\\{1,f_i^{late}-d_i-a_i\\}, L_k=median_i max\\{1,\\ell_i^{max}\\}; u=(0,0.5,0.7), \\alpha_k=u_k/S_k, \\beta_k=(1-u_k)/L_k",
