        "hard": true
      },
      {
        "id": "CON-Q1-2",
        "meaning": "\\mathcal T_{train}^{*}=\\{168,\\ldots,2351\\};\\ \\boldsymbol\\phi_{rkt}\\text{仅由时点}t\\text{以前的观测构造，不使用负时间、未来值或缺失填充值}",
        "hard": true
      },
      {
        "id": "CON-Q1-3",
        "meaning": "\\overline D_{rk,t}^{(h)}=h^{-1}\\sum_{j=1}^{h}D_{rk,t-j},\\ h\\in\\{24,168\\}",
        "hard": true
      },
      {
        "id": "CON-Q1-4",
        "meaning": "\\omega_{it}(s)=\\max\\{0,\\min(s+d_i,t+1)-\\max(s,t)\\}",
        "hard": true
      },
      {
        "id": "CON-Q1-5",
        "meaning": "\\mathcal S_{ir}=\\{s:s\\ge a_i,\\ s+d_i\\le\\min(f_i^{late},2406),\\ \\ell_{o_i r}\\le\\ell_i^{max}\\}",
        "hard": true
      },
      {
        "id": "CON-Q1-6",
