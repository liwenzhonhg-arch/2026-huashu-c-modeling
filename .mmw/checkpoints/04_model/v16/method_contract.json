  "formulation": {
    "model_family": "在完整历史样本168–2351上训练，在2352–2375验证；模型选择后用168–2375重训并测试2376–2399。验证和测试特征仅使用预测时点以前的真实观测。最后24小时以实际任务求解MILP。；带累计状态和唯一提交区的滚动时域ε-约束MILP。固定H=168 h、O=24 h、F=144 h；仅提交区冻结并计数，重叠区重新优化。每问最多12个ε组合、单候选最多30 s，所有候选共享300 s墙钟合同。；分源储能MILP。最终峰值一律由净购电序列复算；辅助峰值变量只用于约束。每问最多12个ε组合、单候选最多30 s，并服从共享300 s墙钟合同。；带全时域累计状态、剩余可达界和唯一提交区的滚动ε-约束联合MILP。最大化指标先转换为J_U=1-U_RE和J_Q=1-Q_service。最终候选必须通过完整全时域复算。",
    "objectives": [
      {
        "id": "OBJ-Q1",
        "meaning": "\\min_{\\beta_{0,rk},\\boldsymbol\\beta_{rk}}\\sum_{t\\in\\mathcal T_{train}^{*}}\\rho_{\\delta_H}(D_{rkt}-\\beta_{0,rk}-\\boldsymbol\\beta_{rk}^{\\top}\\boldsymbol\\phi_{rkt})+\\lambda\\|\\boldsymbol\\beta_{rk}\\|_2^2;\\quad \\widehat D_{rkt}=\\max\\{0,\\beta_{0,rk}+\\boldsymbol\\beta_{rk}^{\\top}\\boldsymbol\\phi_{rkt}\\};\\quad \\min_x\\sum_{i,r,s}x_{irs}[\\alpha_{k_i}(s-a_i)+\\beta_{k_i}\\ell_{o_i r}]",
        "unit": ""
      },
      {
        "id": "OBJ-Q2",
        "meaning": "\\min C_{op}=\\sum_{r,t}(\\pi_{rt}^{buy}B_{rt}-\\pi_{rt}^{sell}S_{rt})\\Delta t",
        "unit": ""
      },
      {
        "id": "OBJ-Q3",
        "meaning": "\\min C_{op}\\quad\\text{s.t.}\\quad E_{CO2}\\le\\varepsilon_C,\\ P_r^{peak}\\le\\varepsilon_{P,r},\\ V\\le\\varepsilon_V;\\quad V=\\sum_{r,t\\ge1}z_{rt}",
        "unit": ""
      },
      {
        "id": "OBJ-Q4",
        "meaning": "\\min C_{op}\\quad\\text{s.t.}\\quad E_{CO2}\\le\\varepsilon_C,\\ L_{net}\\le\\varepsilon_L,\\ U_{RE}\\ge\\varepsilon_U,\\ Q_{service}\\ge\\varepsilon_Q,\\ P_r^{peak}\\le\\varepsilon_{P,r}",
        "unit": ""
      }
    ],
    "constraints": [
      {
