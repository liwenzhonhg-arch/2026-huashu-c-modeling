      {
        "id": "CON-Q2-9",
        "meaning": "b_1=0,b_{j+1}=b_j+F,e_j=min(b_j+H-1,2406)；滚动窗口W_j=[b_j,e_j]，提交区F_j=[b_j,min(b_j+F-1,2406)]，F=H-O=144；仅F_j计入累计量",
        "hard": true
