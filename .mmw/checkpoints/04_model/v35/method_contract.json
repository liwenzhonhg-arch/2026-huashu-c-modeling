        "meaning": "S_{r,-1}=S_r^0；S_{rt}=S_{r,t-1}+\\eta_r^cC_{rt}\\Delta t-D_{rt}\\Delta t/\\eta_r^d",
        "hard": true
      },
      {
        "id": "CON-Q3-5",
        "meaning": "S_r^{min}\\le S_{rt}\\le S_r^{max}；S_{r,2406}\\ge S_r^0",
