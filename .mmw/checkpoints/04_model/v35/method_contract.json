        "hard": true
      },
      {
        "id": "CON-Q2-7",
        "meaning": "窗口w要求A_C^{w-1}+\\Delta A_C^w\\le\\varepsilon_C，A_L^{w-1}+\\Delta A_L^w\\le\\varepsilon_L(A_W^{w-1}+\\Delta A_W^w+W_{rem}^{LB})，A_U^w+R_{rem}^{av}\\ge\\varepsilon_UA_R^{total}",
