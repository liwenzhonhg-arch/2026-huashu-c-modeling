      },
      {
        "id": "CON-Q3-8",
        "meaning": "\\widehat P_r^{peak}=\\max_tN_{rt}；\\widehat V_r=\\sum_{t=1}^{2406}|N_{rt}-N_{r,t-1}|，正式报告使用复算值",
        "hard": true
      },
      {
        "id": "CON-Q3-9",
