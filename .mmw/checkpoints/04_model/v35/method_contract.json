        "meaning": "R_{rt}^{use}+R_{rt}^{sell}+R_{rt}^{curt}=R_{rt}^{av}",
        "hard": true
      },
      {
        "id": "CON-Q2-3",
        "meaning": "G_{rt}^{buy}+R_{rt}^{use}=L_{rt}^{F}；G_{rt}^{sell}=R_{rt}^{sell}",
        "hard": true
      },
      {
        "id": "CON-Q2-4",
        "meaning": "0\\le G_{rt}^{buy}\\le I_r^{max}y_{rt}^{grid}；0\\le G_{rt}^{sell}\\le E_r^{max}(1-y_{rt}^{grid})；y_{rt}^{grid}\\in\\{0,1\\}",
        "hard": true
