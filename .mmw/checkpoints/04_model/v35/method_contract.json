      },
      {
        "id": "CON-Q3-3",
        "meaning": "0\\le G_{rt}^{buy}\\le I_r^{max}y_{rt}^{grid}；0\\le G_{rt}^{sell}\\le E_r^{max}(1-y_{rt}^{grid})；y_{rt}^{grid}\\in\\{0,1\\}",
        "hard": true
      },
      {
