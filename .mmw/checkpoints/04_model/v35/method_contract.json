      {
        "id": "CON-Q3-6",
        "meaning": "0\\le C_{rt}\\le u_{rt}^cC_r^{max}；0\\le D_{rt}\\le(1-u_{rt}^c)D_r^{max}；u_{rt}^c\\in\\{0,1\\}",
        "hard": true
      },
      {
        "id": "CON-Q3-7",
        "meaning": "N_{rt}=G_{rt}^{buy}-G_{rt}^{sell}；P_r^{peak}\\ge N_{rt}；z_{rt}\\ge\\pm(N_{rt}-N_{r,t-1})；V_r=\\sum_{t=1}^{2406}z_{rt}",
