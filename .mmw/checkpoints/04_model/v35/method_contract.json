  "formulation": {
    "model_family": "验证集选择季节性朴素模型或滞后正则化回归；0–2375重训；先审计并冻结前序承诺，再对最后24小时实际任务求MILP；固定168小时滚动MILP；计算五条联合epsilon路径上的有限候选；传递累计量和剩余预算，最终全时域复算；固定负荷储能MILP；五条联合epsilon路径上的有限候选；二级目标消除峰值和爬坡辅助量松弛；固定168小时滚动联合MILP；五条联合epsilon路径仅形成有限候选集；累计预算传递；全时域复算可行性后按统一方向损失选折中解",
    "objectives": [
      {
        "id": "OBJ-Q1",
        "meaning": "预测：\\min\\sum\\rho(D_{rkt}-\\widehat D_{rkt})+\\lambda\\|\\beta\\|_2^2；调度词典序\\min[\\sum_{i\\in\\mathcal I^{end}}(s_i-a_i),\\sum_{i,r,s}\\ell_{o_ir}x_{irs},U^{max}]，其中s_i由shared_definitions.task_binding唯一派生",
        "unit": ""
      },
      {
        "id": "OBJ-Q2",
        "meaning": "\\min C_{op}\\ \\mathrm{s.t.}\\ E_{CO2}\\le\\varepsilon_C,\\ L_{net}\\le\\varepsilon_L,\\ U_{RE}^{q2}\\ge\\varepsilon_U",
        "unit": ""
      },
      {
        "id": "OBJ-Q3",
        "meaning": "词典序\\min[C_{op},\\sum_rP_r^{peak}+\\sum_{r,t}z_{rt}]\\ \\mathrm{s.t.}\\ E_{CO2}\\le\\varepsilon_C,\\ P_r^{peak}\\le\\varepsilon_{P,r},\\ V_r\\le\\varepsilon_{V,r}",
        "unit": ""
      },
      {
        "id": "OBJ-Q4",
        "meaning": "\\min C_{op}\\ \\mathrm{s.t.}\\ E_{CO2}\\le\\varepsilon_C,\\ L_{net}\\le\\varepsilon_L,\\ Q_{service}\\ge\\varepsilon_Q,\\ U_{RE}^{q4}\\ge\\varepsilon_U,\\ P_r^{peak}\\le\\varepsilon_{P,r}",
        "unit": ""
      }
    ],
    "constraints": [
      {
        "id": "CON-Q1-1",
        "meaning": "预测划分为train=0:2351，validation=2352:2375，test=2376:2399",
        "hard": true
      },
      {
        "id": "CON-Q1-2",
        "meaning": "\\sum_{(r,s)\\in\\Omega_i}x_{irs}=1；s_i=\\sum s x_{irs}；c_i=s_i+d_i/60；实时任务s_i=a_i",
        "hard": true
      },
      {
        "id": "CON-Q1-3",
        "meaning": "\\mathcal I^{pre}=\\{i:a_i<2376,\\ s_i^0+d_i/60>2376\\}；每个前序承诺(r_i^0,s_i^0)必须先通过唯一执行、到达、实时即时开工、时延、截止、GPU、IT功率、设施功率和2406禁占用审计",
        "hard": true
      },
      {
        "id": "CON-Q1-4",
        "meaning": "b_{rt}^{GPU}=\\sum_{i\\in\\mathcal I^{pre}:r_i^0=r}g_i\\alpha_{it}(s_i^0)；b_{rt}^{AI}=\\sum_{i\\in\\mathcal I^{pre}:r_i^0=r}g_ip_{k_i}^{GPU}\\alpha_{it}(s_i^0)",
        "hard": true
      },
      {
        "id": "CON-Q1-5",
        "meaning": "b_{rt}^{GPU}+\\sum_{i\\in\\mathcal I^{end},s}g_i\\alpha_{it}(s)x_{irs}\\le G_r^{max}",
        "hard": true
      },
      {
        "id": "CON-Q1-6",
        "meaning": "L_{rt}^{AI,end}=b_{rt}^{AI}+\\sum_{i\\in\\mathcal I^{end},s}g_ip_{k_i}^{GPU}\\alpha_{it}(s)x_{irs}",
        "hard": true
      },
      {
        "id": "CON-Q1-7",
        "meaning": "L_{rt}^{IT,end}=L_{rt}^{N}+L_{rt}^{AI,end}；L_{rt}^{F,end}=\\pi_rL_{rt}^{IT,end}",
        "hard": true
      },
      {
        "id": "CON-Q1-8",
        "meaning": "L_{rt}^{IT,end}\\le P_r^{IT,max}；L_{rt}^{F,end}\\le P_r^{F,max}",
        "hard": true
      },
      {
        "id": "CON-Q1-9",
        "meaning": "U^{max}\\ge(b_{rt}^{GPU}+\\sum_{i\\in\\mathcal I^{end},s}g_i\\alpha_{it}(s)x_{irs})/G_r^{max}",
        "hard": true
      },
      {
        "id": "CON-Q2-1",
        "meaning": "shared_definitions中的候选集、任务绑定、GPU、IT功率、设施功率约束全部成立",
