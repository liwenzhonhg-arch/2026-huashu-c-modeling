  "formulation": {
    "model_family": "0–2351训练、2352–2375验证，选型后0–2375重训；最后24小时用实际任务调度。四问共用300秒合同，q1固定工作启动前检查共同截止。；固定7个epsilon候选：成本、碳、时延、新能源四个单目标参照点及三组预声明折中预算；按该顺序求解。滚动窗口冻结承诺段内全部任务决策。；固定7个候选：成本、碳、峰值、波动四个参照点及三组折中预算，按固定顺序求解。；固定7个基准Pareto候选后按固定顺序计算27个情景；四问共用B_total=300秒、D_search=t_start+285秒、T_tail=15秒。",
    "objectives": [
      {
        "id": "OBJ-Q1",
        "meaning": "岭回归：min_{beta0,beta} sum(D_rkt-beta0-beta^T z_rkt)^2+lambda||beta||_2^2，Dhat_rkt=max(0,beta0+beta^T z_rkt)；调度词典序最小化未完成数、最大延迟、总等待、总网络时延。",
        "unit": ""
      },
      {
        "id": "OBJ-Q2",
        "meaning": "min C_op=sum(pi_rt^buy P_rt^buy-pi_rt^sell P_rt^sell)Delta_t，满足E_CO2<=epsilon_C、L_net<=epsilon_L、U_RE>=epsilon_U。",
        "unit": ""
      },
      {
        "id": "OBJ-Q3",
        "meaning": "min C_op，满足E_CO2<=epsilon_C、P_r^peak<=epsilon_{P,r}、V_r<=epsilon_{V,r}。",
        "unit": ""
      },
      {
        "id": "OBJ-Q4",
        "meaning": "min C_op，满足E_CO2<=epsilon_C^sc、L_net<=epsilon_L、Q_service>=epsilon_Q、U_RE>=epsilon_U、P_r^peak<=epsilon_{P,r}。",
        "unit": ""
      }
    ],
    "constraints": [
      {
        "id": "CON-Q1-1",
        "meaning": "q_it(s)=max{0,min(t+Delta_t,s+d_i)-max(t,s)}。",
        "hard": true
      },
      {
        "id": "CON-Q1-2",
        "meaning": "sum_{(r,s)in Omega_i}x_irs=1；实时任务s=a_i；s+d_i<=min(f_i,2406)。",
        "hard": true
      },
      {
        "id": "CON-Q1-3",
        "meaning": "P_rt^AI=(1/Delta_t)sum_{i,s}g_i p_{k_i}^GPU q_it(s)x_irs。",
        "hard": true
      },
      {
        "id": "CON-Q1-4",
        "meaning": "sum_{i,s}g_i q_it(s)x_irs<=G_r Delta_t。",
        "hard": true
      },
      {
        "id": "CON-Q1-5",
        "meaning": "P_rt^IT=P_rt^nonAI+P_rt^AI<=P_r^{IT,max}；PUE_r P_rt^IT<=P_r^{fac,max}。",
        "hard": true
      },
      {
        "id": "CON-Q1-6",
        "meaning": "Util_rt^GPU=sum g_i q_it(s)x_irs/(G_r Delta_t)；仅当G_r Delta_t>0时计算，否则metric_unavailable。",
        "hard": true
      },
      {
        "id": "CON-Q1-7",
        "meaning": "WAPE=sum|D-Dhat|/sum|D|仅在分母为正时计算；否则仅报告MAE和RMSE。",
        "hard": true
      },
      {
        "id": "CON-Q2-1",
        "meaning": "继承q1任务、GPU-hour、IT与设施容量约束。",
        "hard": true
      },
      {
        "id": "CON-Q2-2",
        "meaning": "U_rt^RE+P_rt^sell+P_rt^curt=A_rt^RE；P_rt^buy+U_rt^RE=P_rt^fac。",
        "hard": true
      },
      {
        "id": "CON-Q2-3",
        "meaning": "P_rt^ch=P_rt^dis=P_rt^{RE,ch}=P_rt^{grid,ch}=0。",
        "hard": true
      },
      {
        "id": "CON-Q2-4",
        "meaning": "0<=P_rt^buy<=P_rt^{grid,max}y_rt^{trade}；0<=P_rt^sell<=M_P_r(1-y_rt^{trade})；M_P_r=min(P_rt^{export,max},S_r^max)，y_rt^{trade}为二元变量。",
        "hard": true
      },
      {
        "id": "CON-Q2-5",
        "meaning": "E_CO2=sum c_rt P_rt^buy Delta_t。",
        "hard": true
      },
      {
        "id": "CON-Q2-6",
        "meaning": "L_net=sum g_i d_i ell_{o_i r}x_irs/sum g_i d_i；U_RE=sum(U_rt^RE+P_rt^sell)Delta_t/sum A_rt^RE Delta_t；零分母时metric_unavailable并排除对应排序。",
        "hard": true
      },
      {
        "id": "CON-Q3-1",
        "meaning": "P_rt^fac=PUE_r(P_rt^baseAI+P_rt^nonAI)。",
        "hard": true
      },
      {
        "id": "CON-Q3-2",
        "meaning": "U_rt^RE+P_rt^{RE,ch}+P_rt^sell+P_rt^curt=A_rt^RE；P_rt^buy+U_rt^RE+P_rt^dis=P_rt^fac+P_rt^{grid,ch}。",
        "hard": true
      },
      {
        "id": "CON-Q3-3",
        "meaning": "P_rt^ch=P_rt^{RE,ch}+P_rt^{grid,ch}。",
        "hard": true
      },
      {
        "id": "CON-Q3-4",
        "meaning": "E_rt=E_{r,t-1}+eta_r^c P_rt^ch Delta_t-P_rt^dis Delta_t/eta_r^d；E_{r,2406}>=E_r^0。",
        "hard": true
      },
      {
        "id": "CON-Q3-5",
        "meaning": "充放电互斥；购售电使用q2交易互斥约束。",
        "hard": true
      },
      {
        "id": "CON-Q3-6",
        "meaning": "N_rt=P_rt^buy-P_rt^sell；P_r^peak>=0且P_r^peak>=N_rt；V_r=sum_{t=1}^{2406}|N_rt-N_{r,t-1}|的标准线性化。",
        "hard": true
      },
      {
        "id": "CON-Q4-1",
        "meaning": "继承q1和q3全部修正约束，P_r^peak>=0。",
        "hard": true
      },
      {
        "id": "CON-Q4-2",
        "meaning": "epsilon_C^sc=alpha_C E_CO2^ref；E_CO2^ref为基准电价、基准新能源下无碳上限的成本最小完整可行联合方案的复算排放。",
        "hard": true
      },
      {
        "id": "CON-Q4-3",
        "meaning": "S_W=clip(1-Wbar/W_ref,0,1)；零参考或空集合时删除对应项并重新归一化。",
        "hard": true
      },
      {
        "id": "CON-Q4-4",
        "meaning": "27个情景按alpha_C、beta_price、beta_RE的字典序求解；基准Pareto固定7个候选。",
        "hard": true
      },
      {
        "id": "CON-Q4-5",
        "meaning": "滚动窗口冻结所有已承诺任务，包括尚未开工者。",
        "hard": true
      },
      {
        "id": "CON-Q4-6",
        "meaning": "每个窗口末tau满足E_{r,tau}+eta_r^c P_r^{ch,max}(2406-tau)Delta_t>=E_r^0，保证终端SOC仍可达。",
        "hard": true
      },
      {
        "id": "CON-Q4-7",
        "meaning": "每个候选启动前检查同一D_search；不能在B_total前完成的候选不启动，部分解丢弃。",
        "hard": true
      }
    ]
  },
