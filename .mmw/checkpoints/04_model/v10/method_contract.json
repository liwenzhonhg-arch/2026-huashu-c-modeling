  "formulation": {
    "model_family": "季节性朴素基线与滞后特征正则化回归择优；最后24小时采用MILP，启发式仅作热启动或后备可行解；滚动时域epsilon约束多目标MILP；成本单目标MILP作为参照与后备；含充放电互斥、峰值及绝对爬坡线性化的储能MILP；若业务核验允许购电供负荷与新能源外送并存，则不设置购售电互斥；候选筛除后的分层滚动联合MILP与epsilon约束Pareto优化，利用归一化理想点距离选折中解",
    "objectives": [
      {
        "id": "OBJ-Q1",
        "meaning": "\\min \\sum_{r,k,t\\in\\mathcal V}|D_{rkt}-\\widehat D_{rkt}|+\\lambda\\|\\boldsymbol\\beta\\|_2^2；调度阶段取 \\min \\sum_i[(s_i-a_i)+\\omega_\\ell\\ell_{o_i r_i}]",
        "unit": ""
      },
      {
        "id": "OBJ-Q2",
        "meaning": "\\min C_{op}=\\sum_{r,t}(\\pi^{buy}_{rt}P^{buy}_{rt}-\\pi^{sell}_{rt}P^{sell}_{rt})\\Delta t",
        "unit": ""
      },
      {
        "id": "OBJ-Q3",
        "meaning": "\\min C_{op}+\\mu_C E_{CO2}+\\sum_r(\\mu_P P_r^{peak}+\\mu_V V_r)，正式Pareto计算改用epsilon约束而非直接混合量纲",
        "unit": ""
      },
      {
        "id": "OBJ-Q4",
        "meaning": "\\min C_{op}\\quad\\text{s.t.}\\quad E_{CO2}\\le\\epsilon_C,\\ L_{net}\\le\\epsilon_L,\\ Q_{service}\\ge\\epsilon_Q,\\ U_{RE}\\ge\\epsilon_U,\\ P_r^{peak}\\le\\epsilon_{P,r}",
        "unit": ""
      }
    ],
    "constraints": [
      {
        "id": "CON-Q1-1",
        "meaning": "\\sum_{r,s\\in\\Omega_i}x_{irs}=1,\\ \\forall i",
        "hard": true
      },
      {
        "id": "CON-Q1-2",
        "meaning": "s=a_i\\ 对实时推理任务；a_i\\le s且s+d_i\\le\\min(f_i,2406)\\ 对弹性任务",
        "hard": true
      },
      {
        "id": "CON-Q1-3",
        "meaning": "\\ell_{o_i r}\\le\\ell_i^{max}",
        "hard": true
      },
      {
        "id": "CON-Q1-4",
        "meaning": "\\sum_{i,s}g_i q_{it}(s)x_{irs}\\le G_r",
        "hard": true
      },
      {
        "id": "CON-Q1-5",
        "meaning": "P_{rt}^{IT}\\le P_r^{IT,max},\\ P_{rt}^{fac}\\le P_r^{fac,max}",
        "hard": true
      },
      {
        "id": "CON-Q1-6",
        "meaning": "x_{irs}\\in\\{0,1\\}，且任何任务不占用第2406小时",
        "hard": true
      },
      {
        "id": "CON-Q2-1",
        "meaning": "沿用q1的唯一执行、即时开工、截止、时延、GPU、IT及设施功率约束",
        "hard": true
      },
      {
        "id": "CON-Q2-2",
        "meaning": "P^{buy}_{rt}+u_{rt}+P^{dis}_{rt}=P^{fac}_{rt}+P^{ch}_{rt}+P^{sell}_{rt}",
        "hard": true
      },
      {
        "id": "CON-Q2-3",
        "meaning": "0\\le u_{rt}\\le A^{RE}_{rt}",
        "hard": true
      },
      {
        "id": "CON-Q2-4",
        "meaning": "E_{CO2}=\\sum_{r,t}c_{rt}P^{buy}_{rt}\\Delta t\\le\\epsilon_C",
        "hard": true
      },
      {
        "id": "CON-Q2-5",
        "meaning": "L_{net}\\le\\epsilon_L",
        "hard": true
      },
      {
        "id": "CON-Q2-6",
        "meaning": "U_{RE}\\ge\\epsilon_U",
        "hard": true
      },
      {
        "id": "CON-Q2-7",
        "meaning": "0\\le P^{buy}_{rt}\\le P^{grid,max}_{rt},\\ 0\\le P^{sell}_{rt}\\le P^{export,max}_{rt}",
        "hard": true
      },
      {
        "id": "CON-Q3-1",
        "meaning": "P^{fac}_{rt}=PUE_r(P^{baseAI}_{rt}+P^{nonAI}_{rt})",
        "hard": true
      },
      {
        "id": "CON-Q3-2",
        "meaning": "P^{buy}_{rt}+U^{RE}_{rt}+P^{dis}_{rt}=P^{fac}_{rt}+P^{grid,ch}_{rt}+P^{sell}_{rt}",
        "hard": true
      },
      {
