        "hard": true
      },
      {
        "id": "CON-Q3-6",
        "meaning": "E_{r,-1}=E_r^0,\\ E_r^{min}\\le E_{rt}\\le E_r^{max},\\ E_{r,2406}\\ge E_r^0",
        "hard": true
      },
      {
        "id": "CON-Q3-7",
        "meaning": "0\\le P^{ch}_{rt}\\le P_r^{ch,max}z^{ch}_{rt},\\ 0\\le P^{dis}_{rt}\\le P_r^{dis,max}(1-z^{ch}_{rt})",
        "hard": true
      },
      {
        "id": "CON-Q3-8",
        "meaning": "P_r^{peak}\\ge P^{buy}_{rt}-P^{sell}_{rt}",
        "hard": true
      },
      {
