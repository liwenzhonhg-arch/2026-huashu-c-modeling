        "hard": true
      },
      {
        "id": "CON-Q1-6",
        "meaning": "L_{rt}^{N}+b_{rt}^{AI}+\\sum_{i\\in\\mathcal I^{end},s}g_ip_{k_i}^{GPU}\\alpha_{it}(s)x_{irs}\\le P_r^{IT,max}",
