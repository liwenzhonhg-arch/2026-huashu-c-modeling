  "formulation": {
    "model_family": "验证集选择季节性朴素模型或滞后正则化回归；0–2375重训；按固定前序承诺加最后24小时实际到达任务求MILP；固定168小时滚动MILP；五条联合epsilon锚点路径；传递累计量和剩余预算，最终全时域复算；固定负荷储能MILP；新能源利用率计入新能源充电；二级目标消除峰值和爬坡辅助量松弛；固定168小时滚动联合MILP；五条联合epsilon路径；累计预算传递；所有Pareto指标转为越小越好的损失后归一化",
    "objectives": [
      {
        "id": "OBJ-Q1",
        "meaning": "预测：\\min\\sum\\rho(D_{rkt}-\\widehat D_{rkt})+\\lambda\\|\\beta\\|_2^2；调度词典序\\min[\\sum_i(s_i-a_i),\\sum_{i,r,s}\\ell_{o_ir}x_{irs},U^{max}]",
        "unit": ""
      },
      {
        "id": "OBJ-Q2",
        "meaning": "\\min C_{op}\\ \\mathrm{s.t.}\\ E_{CO2}\\le\\varepsilon_C,\\ L_{net}\\le\\varepsilon_L,\\ U_{RE}\\ge\\varepsilon_U",
        "unit": ""
      },
      {
        "id": "OBJ-Q3",
        "meaning": "\\min C_{op}\\ \\mathrm{s.t.}\\ E_{CO2}\\le\\varepsilon_C,\\ P_r^{peak}\\le\\varepsilon_{P,r},\\ V_r\\le\\varepsilon_{V,r}",
        "unit": ""
      },
      {
        "id": "OBJ-Q4",
        "meaning": "\\min C_{op}\\ \\mathrm{s.t.}\\ E_{CO2}\\le\\varepsilon_C,\\ L_{net}\\le\\varepsilon_L,\\ Q_{service}\\ge\\varepsilon_Q,\\ U_{RE}\\ge\\varepsilon_U,\\ P_r^{peak}\\le\\varepsilon_{P,r}",
        "unit": ""
      }
    ],
    "constraints": [
      {
