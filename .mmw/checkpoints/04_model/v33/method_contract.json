      },
      {
        "id": "CON-Q1-6",
        "meaning": "U^{max}\\ge\\bigl(b_{rt}^{GPU}+\\sum_{i:a_i\\ge2376,s}g_i\\omega_{it}(s)x_{irs}\\bigr)/G_r^{max},\\quad\\forall r,t=2376,\\ldots,2405",
        "hard": true
      },
      {
        "id": "CON-Q1-7",
        "meaning": "\\widehat D_{rkt}=\\max\\{0,\\beta_0+\\sum_{\\ell\\in\\mathcal L}\\beta_\\ell D_{rk,t-\\ell}+\\gamma^Tz_t+\\alpha_r+\\delta_k\\}",
        "hard": true
      },
      {
        "id": "CON-Q1-8",
