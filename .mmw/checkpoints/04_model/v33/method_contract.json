  "formulation": {
    "model_family": "季节性朴素模型与滞后特征正则化回归按验证集WAPE和MAE择优；用0–2375重训后测试；最后24小时实际任务采用带固定前序占用的MILP；固定168小时滚动时域epsilon约束MILP；epsilon按shared_definitions.epsilon_rule生成；拼接失败则结构化停止；含充放电互斥、峰值和绝对爬坡线性化的储能MILP；正式主模型采用新能源分源外送口径；固定168小时滚动联合MILP与epsilon约束Pareto优化；epsilon、服务权重、理想点权重和情景网格均在求解前固定",
    "objectives": [
      {
        "id": "OBJ-Q1",
        "meaning": "预测：\\min\\sum_{r,k,t\\in\\mathcal T_{train}}\\rho(D_{rkt}-\\widehat D_{rkt})+\\lambda\\|\\beta\\|_2^2。调度采用词典序\\min[\\sum_i(s_i-a_i),\\sum_{i,r,s}\\ell_{o_ir}x_{irs},U^{max}]",
        "unit": ""
      },
      {
        "id": "OBJ-Q2",
        "meaning": "\\min C_{op},\\quad E_{CO2}\\le\\varepsilon_C,\\ L_{net}\\le\\varepsilon_L,\\ U_{RE}\\ge\\varepsilon_U",
        "unit": ""
      },
      {
        "id": "OBJ-Q3",
        "meaning": "\\min C_{op},\\quad E_{CO2}\\le\\varepsilon_C,\\ P_r^{peak}\\le\\varepsilon_{P,r},\\ V_r\\le\\varepsilon_{V,r}",
        "unit": ""
      },
      {
        "id": "OBJ-Q4",
        "meaning": "\\min C_{op}\\ \\text{s.t.}\\ E_{CO2}\\le\\varepsilon_C,\\ L_{net}\\le\\varepsilon_L,\\ Q_{service}\\ge\\varepsilon_Q,\\ U_{RE}\\ge\\varepsilon_U,\\ P_r^{peak}\\le\\varepsilon_{P,r}",
        "unit": ""
      }
    ],
    "constraints": [
      {
