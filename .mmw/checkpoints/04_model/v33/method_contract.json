        "meaning": "\\sum_{(r,s)\\in\\Omega_i}x_{irs}=1",
        "hard": true
      },
      {
        "id": "CON-Q1-2",
        "meaning": "s_i=\\sum_{r,s}sx_{irs};\\quad i\\in RT\\Rightarrow s_i=a_i",
        "hard": true
      },
      {
        "id": "CON-Q1-3",
        "meaning": "b_{rt}^{GPU}+\\sum_{i:a_i\\ge2376}\\sum_sg_i\\omega_{it}(s)x_{irs}\\le G_r^{max},\\quad t=2376,\\ldots,2405",
        "hard": true
      },
