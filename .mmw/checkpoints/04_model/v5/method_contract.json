        "unit": ""
      },
      {
        "id": "OBJ-Q2",
        "meaning": "\\min C_{op}\\quad\\text{s.t.}\\quad E_{CO2}\\le\\varepsilon_C,\\ L_{net}\\le\\varepsilon_L,\\ U_{RE}\\ge\\varepsilon_U",
        "unit": ""
      },
      {
        "id": "OBJ-Q3",
        "meaning": "\\min C_{op}\\quad\\text{s.t.}\\quad E_{CO2}\\le\\varepsilon_C,\\ P_r^{peak}\\le\\varepsilon_{P,r},\\ V_r\\le\\varepsilon_{V,r}\\ (\\forall r)",
        "unit": ""
      },
      {
        "id": "OBJ-Q4",
        "meaning": "\\min C_{op}\\quad\\text{s.t.}\\quad E_{CO2}\\le\\varepsilon_C,\\ L_{net}\\le\\varepsilon_L,\\ U_{RE}\\ge\\varepsilon_U,\\ Q_{service}\\ge\\varepsilon_Q,\\ P_r^{peak}\\le\\varepsilon_{P,r}",
        "unit": ""
      }
    ],
    "constraints": [
