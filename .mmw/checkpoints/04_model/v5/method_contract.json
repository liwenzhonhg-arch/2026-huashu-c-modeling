      },
      {
        "id": "CON-Q1-2",
        "meaning": "\\mathcal F_i=\\{(r,s):s\\ge a_i,\\ s+d_i/60\\le\\min(f_i,2406),\\ \\ell_{o_ir}\\le L_i^{max}\\};\\ s=a_i\\ \\text{for real-time tasks}",
